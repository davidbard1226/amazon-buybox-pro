{
  "manifest_version": 3,
  "name": "Amazon BuyBox Pro (co.za)",
  "version": "0.1.0",
  "description": "Reads your Seller Central Manage Pricing data (buybox win/lose, your price, buybox price, lowest price) and feeds the Amazon BuyBox Pro dashboard. No API needed.",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://sellercentral.amazon.co.za/*",
    "https://sellercentral.amazon.com/*",
    "file:///*",
    "https://davidbard1226.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://sellercentral.amazon.co.za/*", "https://sellercentral.amazon.com/*"],
      "js": ["content-seller.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["file:///*", "https://davidbard1226.github.io/amazon-buybox-pro/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amazon BuyBox Pro"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}